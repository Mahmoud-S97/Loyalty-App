{
  "expo": {
    "name": "BESTIE",
    "slug": "bestie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/startup/icon.png",
    "scheme": "bestie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mahmoudsaleh.bestie",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./src/assets/images/startup/icon-trans.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mahmoudsaleh.bestie",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/startup/icon.png"
    },
    "plugins": [
      "./plugins/withNFC",
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Inter-Regular.ttf",
            "./src/assets/fonts/Inter-Medium.ttf",
            "./src/assets/fonts/Inter-SemiBold.ttf",
            "./src/assets/fonts/Inter-Bold.ttf",
            "./src/assets/fonts/Cairo-Regular.ttf",
            "./src/assets/fonts/Cairo-Medium.ttf",
            "./src/assets/fonts/Cairo-SemiBold.ttf",
            "./src/assets/fonts/Cairo-Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/startup/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fafafa",
          "dark": {
            "backgroundColor": "#1a1a1a"
          }
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/auth"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
